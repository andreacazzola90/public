{
    "$schema": "https://schemas.wp.org/trunk/block.json",
    "apiVersion": 3,
    "name": "gurus/service-list",
    "title": "Lista Servizi",
    "category": "widgets",
    "icon": "list-view",
    "description": "Mostra i servizi di una categoria con titolo e sottotitolo.",
    "keywords": ["servizi", "service", "lista", "categoria"],
    "supports": {
        "html": false,
        "align": false
    },
    "attributes": {
        "categorySlug": {
            "type": "string",
            "default": "services"
        },
        "showSubtitle": {
            "type": "boolean",
            "default": true
        }
    },
    "editorScript": "file:./index.js",
    "render": "file:./render.php"
}
